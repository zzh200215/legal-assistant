## ===========================================
## 核心数据库配置
## ===========================================
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/aibg
# Docker Compose 使用容器内主机名 mysql，不要复用本地地址。
DATABASE_URL_DOCKER=mysql+pymysql://root:YOUR_PASSWORD@mysql:3306/aibg
MYSQL_ROOT_PASSWORD=YOUR_PASSWORD
DATABASE_POOL_PRE_PING=true
DATABASE_ECHO=false

## ===========================================
## Redis缓存配置
## ===========================================
REDIS_URL=redis://localhost:6379/0

## ===========================================
## 安全密钥配置（必需）
## ===========================================
# 应用密钥：用于JWT签名等，必须设置为至少32字符的强随机字符串
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-secret

# 连接器凭证加密密钥：Fernet URL-safe Base64密钥。为空时从 SECRET_KEY 派生
# 生产环境建议单独配置并妥善轮换
# 生成方法：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_CREDENTIAL_ENCRYPTION_KEY=

# 法律数据加密密钥：32字节URL-safe Base64密钥，用于AES-256-GCM加密。
# 必须独立配置，禁止留空、禁止复用 SECRET_KEY，也不得从 SECRET_KEY 派生；
# 缺失或复用会导致配置加载失败。生成方法：
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
LEGAL_DATA_ENCRYPTION_KEY=
# 生产轮换：{"v1":"<base64-32-byte-key>","v2":"<base64-32-byte-key>"}
LEGAL_DATA_ENCRYPTION_KEYS_JSON=
LEGAL_DATA_ENCRYPTION_ACTIVE_VERSION=v1
# development：本地开发；pilot：3-10 人内部试用，强制法律数据加密；production：生产环境
ENVIRONMENT=development

## ===========================================
## 数据保留策略
## ===========================================
MAILBOX_RETENTION_DAYS=90

## ===========================================
## 告警通知配置
## ===========================================
# 企业微信/钉钉机器人等兼容 Markdown 的 Webhook。留空时不会外送告警
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
ALERT_WEBHOOK_MIN_SEVERITY=high

## ===========================================
## JWT认证配置
## ===========================================
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

## ===========================================
## LLM服务配置（必需）
## ===========================================
# LLM服务提供商：openai_compatible | ollama
LLM_PROVIDER=openai_compatible

# API地址和密钥
LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 重要：必须配置有效的API密钥
LLM_API_KEY=your-dashscope-api-key

# 模型配置
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# 模型路由：简单请求优先走千问小模型；复杂/高风险请求走 LLM_MODEL。
# 小模型地址、Key 留空时复用上面的 OpenAI 兼容配置。请按账号当前可用的免费/低价模型调整；
# qwen-turbo 仅为示例，不代表所有地区、账号或时间均免费。
LLM_MODEL_ROUTING_ENABLED=true
LLM_SMALL_MODEL=qwen-turbo
LLM_SMALL_MODEL_PROVIDER=openai_compatible
LLM_SMALL_MODEL_API_BASE_URL=
LLM_SMALL_MODEL_API_KEY=
LLM_SIMPLE_REQUEST_MAX_CHARS=600
LLM_PRIMARY_REQUEST_RETRIES=2
LLM_FALLBACK_REQUEST_RETRIES=1
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MODEL_FALLBACK_ENABLED=true
LLM_SMALL_MODEL_FALLBACK_TO_PRIMARY=true
# 路由健康告警：只有窗口内请求达到最小样本量，才按失败率触发运营告警。
LLM_ROUTING_ALERT_MIN_REQUESTS=10
LLM_ROUTING_ALERT_PRIMARY_FAILURE_RATE=0.20
LLM_ROUTING_ALERT_FALLBACK_FAILURE_RATE=0.30
# 路由健康告警：只有窗口内请求达到最小样本量，才按失败率触发运营告警。
LLM_ROUTING_ALERT_MIN_REQUESTS=10
LLM_ROUTING_ALERT_PRIMARY_FAILURE_RATE=0.20
LLM_ROUTING_ALERT_FALLBACK_FAILURE_RATE=0.30

# 定价配置（JSON格式）
LLM_PRICE_CURRENCY=CNY
LLM_MODEL_PRICING={"qwen-plus":{"input_per_1k":0.004,"output_per_1k":0.012},"text-embedding-v3":{"input_per_1k":0.0005,"output_per_1k":0.0}}

# 供应商熔断（进程内默认；仅超时/传输/5xx 计入，参数/鉴权/内容拦截不计入）
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
CIRCUIT_BREAKER_HALF_OPEN_MAX_CONCURRENCY=1
# 可选 Redis 后端：默认关闭（进程内即可运行）；跨实例不承诺强一致
CIRCUIT_BREAKER_REDIS_ENABLED=false
CIRCUIT_BREAKER_REDIS_PREFIX=aibg:circuit-breaker

# 独立预算桶 / 限流桶（chat/embedding/vision/rerank 各自独立记账）
# JSON 对象，键为桶类别，未列出的类别回退到上方 LLM_DAILY_REQUEST_LIMIT /
# LLM_DAILY_TOKEN_LIMIT / LLM_RATE_LIMIT_WINDOW_SECONDS / LLM_RATE_LIMIT_MAX_REQUESTS 全局默认。
# budget category: text/embedding/vision/rerank；rate-limit category: chat/embedding/vision/rerank
LLM_BUDGET_LIMITS_JSON={}
LLM_RATE_LIMIT_CONFIG_JSON={}

# LLM 响应缓存：仅显式标记 cacheable 的幂等请求默认走缓存；聊天/含敏感上下文默认不缓存。
# 默认进程内 LRU + TTL（多实例各持一份，无跨实例失效）；启用 Redis 后跨实例共享（非强一致）。
LLM_RESPONSE_CACHE_ENABLED=true
LLM_RESPONSE_CACHE_TTL_SECONDS=3600
LLM_RESPONSE_CACHE_CAPACITY=256
LLM_RESPONSE_CACHE_REDIS_ENABLED=false
LLM_RESPONSE_CACHE_REDIS_PREFIX=aibg:llm-response-cache

# Ollama配置（使用ollama提供商时需要）
OLLAMA_BASE_URL=http://localhost:11434

## ===========================================
## 向量数据库配置
## ===========================================
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_COLLECTION_NAME=documents
LEGAL_VECTOR_STORE_COLLECTION_NAME=legal_articles

# Chroma配置
CHROMA_PERSIST_DIR=./data/chroma_db

# Qdrant配置（使用qdrant提供商时需要）
QDRANT_PERSIST_DIR=./qdrant_db
QDRANT_URL=
QDRANT_API_KEY=

## ===========================================
## Neo4j 法律知识图谱配置（可选）
## ===========================================
# 启用后，法律法源、条文、领域标签和修订关系会同步至 Neo4j，
# 用于为现有关键词/向量召回结果追加可解释的图谱证据。
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=20
# Graph RAG 只对已召回候选做有界排序增强，不扩展候选集。
LEGAL_GRAPH_EVIDENCE_BOOST=0.001
LEGAL_GRAPH_EVIDENCE_MAX_SUPPORT_COUNT=3

## ===========================================
## OCR配置
## ===========================================
OCR_ENABLE_IMAGE_PREPROCESS=true
OCR_PDF_RENDER_DPI=200
OCR_MIN_TEXT_LENGTH=24
OCR_MIN_READABLE_RATIO=0.45

## ===========================================
## 文档存储与上传安全（P0 文档生命周期）
## ===========================================
# 存储后端：local（默认，可用）| minio | s3 | oss。云后端需安装对应可选 SDK，
# 未安装时启用会抛 StorageBackendUnavailable 并给出指引；本地实现始终可用。
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/uploads
# 可选云存储配置（选用对应后端时填写；密钥不落日志）
STORAGE_MINIO_ENDPOINT=
STORAGE_MINIO_ACCESS_KEY=
STORAGE_MINIO_SECRET_KEY=
STORAGE_MINIO_BUCKET=documents
STORAGE_MINIO_SECURE=true
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_BUCKET=documents
STORAGE_OSS_ENDPOINT=
STORAGE_OSS_ACCESS_KEY=
STORAGE_OSS_SECRET_KEY=
STORAGE_OSS_BUCKET=documents
# 上传安全：单文件大小上限（MB）
DOCUMENT_MAX_UPLOAD_MB=50
# MIME 白名单（扩展名，逗号分隔）
DOCUMENT_ALLOWED_EXTENSIONS=pdf,docx,xlsx,md,txt,png,jpg,jpeg,bmp,webp
# 病毒扫描：默认关闭（Noop“未配置扫描器”策略，不伪造结果）；开启后需要 ClamAV clamd
DOCUMENT_VIRUS_SCAN_ENABLED=false
DOCUMENT_CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
# zip-bomb 防护（docx/xlsx 等 ZIP 容器）：条目数/总解压大小(MB)/压缩比/嵌套层数
DOCUMENT_ZIP_MAX_ENTRIES=500
DOCUMENT_ZIP_MAX_TOTAL_UNCOMPRESSED_MB=200
DOCUMENT_ZIP_MAX_COMPRESSION_RATIO=1000.0
DOCUMENT_ZIP_MAX_NESTING=2

## ===========================================
## 文档处理任务（重试与租约）
## ===========================================
DOCUMENT_TASK_MAX_RETRIES=2
DOCUMENT_TASK_BACKOFF_BASE_SECONDS=5
DOCUMENT_JOB_LEASE_TTL_SECONDS=300
DOCUMENT_JOB_LEASE_RENEW_INTERVAL_SECONDS=60

## ===========================================
## Agent Run 可靠性（统一工具执行链路 / 审批 / 幂等）
## ===========================================
# 工具执行超时（秒）
AGENT_TOOL_TIMEOUT_SECONDS=45
AGENT_PARALLEL_MAX_WORKERS=2
# run/step 超时
AGENT_RUN_DEADLINE_SECONDS=600
AGENT_STEP_DEADLINE_SECONDS=120
# 工具暂时性失败重试策略
AGENT_TOOL_MAX_RETRIES=1
AGENT_TOOL_BACKOFF_BASE_SECONDS=2
# 审批过期时间（秒）：到期未决审批不可执行
AGENT_APPROVAL_EXPIRE_SECONDS=3600
# 写工具幂等去重开关
AGENT_TOOL_IDEMPOTENCY_ENABLED=true

## ===========================================
## SQLTool 只读安全（AST 级解析 + 白名单 + 脱敏 + 只读账号）
## ===========================================
SQL_QUERY_TIMEOUT_SECONDS=10
SQL_QUERY_MAX_ROWS=200
SQL_RESULT_MAX_CHARS=100000
# 逗号分隔的 schema/表白名单；生产必须配置（空=不按该维度限制）
SQL_ALLOWED_SCHEMAS=
SQL_ALLOWED_TABLES=
# 逗号分隔的敏感列名：输出值脱敏为 ****（如 email,phone,id_card,address,token）
SQL_REDACT_COLUMNS=
# 独立只读数据库账号连接串；未配置且 ENFORCE 开启时使用应用主账号并显式告警
SQL_DATABASE_URL=
SQL_ENFORCE_READONLY_ACCOUNT=true

## ===========================================
## RAG检索配置
## ===========================================
AGENTIC_RAG_ENABLED=true
AGENTIC_RAG_PLANNER_ENABLED=true
AGENTIC_RAG_MAX_RETRIEVAL_ROUNDS=2

## ===========================================
## 对话长期记忆配置
## ===========================================
# 仅从会话摘要中提取回复风格、语言、输出格式和工作偏好；
# 不提取法律事实、文档内容或个人敏感信息。
CONVERSATION_MEMORY_AUTO_PREFERENCE_ENABLED=true
CONVERSATION_MEMORY_AUTO_PREFERENCE_MAX_ITEMS=3

## ===========================================
## 对话长期记忆配置
## ===========================================
# 仅从会话摘要中提取回复风格、语言、输出格式和工作偏好；
# 不提取法律事实、文档内容或个人敏感信息。
CONVERSATION_MEMORY_AUTO_PREFERENCE_ENABLED=true
CONVERSATION_MEMORY_AUTO_PREFERENCE_MAX_ITEMS=3

## ===========================================
## 管理员账号配置（必需）
## ===========================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# 重要：必须设置强密码
ADMIN_PASSWORD=replace-with-a-strong-admin-password

## ===========================================
## WebSocket配置
## ===========================================
VITE_WS_HOST=localhost:8001

## ===========================================
## 通知/邮件/邮箱同步投递可靠性（Outbox 领取、审批、DLP、死信）
## ===========================================
# 站内低风险通知自动批准（分级审批：站内自动 / 对外邮件审批）。
AUTO_APPROVE_SITE_NOTIFICATION=true
# 发往内部用户本人邮箱的通知自动批准；对外收件人走审批。
AUTO_APPROVE_EMAIL_NOTIFICATION_TO_OWNER=true
# 对外邮件通知是否需要审批。默认偏安全：无法判定时不得自动外发。
EMAIL_NOTIFICATION_REQUIRE_APPROVAL=true
# 通知领取批次与租约 TTL（worker 崩溃后按 TTL 回收重领）。
NOTIFICATION_CLAIM_BATCH_SIZE=50
NOTIFICATION_CLAIM_TTL_SECONDS=300
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BACKOFF_BASE_SECONDS=60
# 邮件投递（EmailSendRequest 作为 Outbox）重试与租约。
EMAIL_DELIVERY_MAX_ATTEMPTS=5
EMAIL_DELIVERY_CLAIM_TTL_SECONDS=300
EMAIL_DEAD_LETTER_RETENTION_DAYS=90
# DLP 扫描失败/未配置时的默认行为：block（fail closed）。
DLP_SCAN_FAILURE_ACTION=block
# 邮箱同步（绿地 mock，默认关闭，不复活真实 IMAP 供应商）。
MAILBOX_SYNC_ENABLED=false
MAILBOX_SYNC_BATCH_SIZE=50
MAILBOX_ATTACHMENT_MAX_BYTES=20971520

## ===========================================
## 电子签名webhook配置
## ===========================================
# JSON对象，键为fadada/esigncn，值为对应HMAC密钥
SIGNING_WEBHOOK_SECRETS_JSON={}
# 法大大沙箱适配器（仅服务端配置，不可由业务 API 提交）
SIGNING_FADADA_SANDBOX_URL=
SIGNING_FADADA_API_KEY=

## ===========================================
## E-5 可观测性（Sentry + OpenTelemetry）
## ===========================================
# Sentry 错误上报：DSN 留空则跳过初始化，前端使用 VITE_SENTRY_DSN 同值。
SENTRY_DSN=
# OpenTelemetry 链路追踪：OTEL_ENABLED 与 OTLP 端点齐备才启用（需安装
# opentelemetry 相关依赖；本地/测试默认关闭）
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# 前端 Sentry：由 Vite 读取，留空则前端不加载 Sentry
VITE_SENTRY_DSN=

