{
  "name": "ai-office-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\"",
    "preview": "vite preview",
    "test:unit": "node --test \"src/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "types:gen": "node scripts/gen-api-types.mjs",
    "types:check": "node scripts/gen-api-types.mjs --check",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "bundle:report": "node scripts/check-bundle-budget.mjs --report"
  },
  "dependencies": {
    "@sentry/vue": "^10.69.0",
    "axios": "^1.7.0",
    "element-plus": "^2.8.0",
    "pinia": "^4.0.3",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "postcss": "^8.5.16",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.2",
    "vite": "^5.4.0"
  }
}
