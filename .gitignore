logs/
tmp/
*.log
*.out.log
*.err.log

# Node
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# Playwright artifacts
frontend/test-results/
frontend/playwright-report/

# Chroma
chroma_db/

# IDE
.vscode/
.idea/
.tmp_run/
.reasonix/

# Firecrawl CLI 输出（求职/检索等临时数据，勿混入仓库）
.firecrawl/

# 求职面试材料（个人讲稿与讲解图，勿混入仓库）
/面试准备.md
/docs/interview/

# Env
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# DR backups (contain unencrypted DB dumps; never commit)
backups/

# Runtime data (sqlite DB, uploads, backups, daily check / baseline / weekly artifacts)
data/

# Seed 演示产物（scripts/seed_demo_data.py 重新生成）
/uploads/

# Runtime cursor for review-feedback eval export
scripts/review_feedback_state.json

# Eval run artifacts (generated reports; dataset & scripts are tracked)
eval/outputs/*
# 例外：baseline 快照是回归门禁的锚点（scripts/eval_baseline.py --check 要读它），
# 与其它评测产物不同，它需要入库；参数/prompt 版本漂移会被 --check 点名。
!eval/outputs/baseline_snapshot.json

# jieba 分词缓存（检索评测首次运行时按 CWD 落盘）
jieba.cache

# 本地临时产物：评测/探针脚本的中间目录与临时向量库（可随时重建）
.tmp_*/
chroma_eval_store/
aibg_test_chroma/
# 测试临时根目录（TEMP 不可用时 conftest 的兜底位置）
.pytest_tmp/

# External repo export artifacts (_repo_main.py, _repo_meta.json, etc.)
_repo_*

# Test artifacts (accidental mock-object dirs created by tests)
MagicMock/
MagicMock*/

# Archived dead/legacy code (大扫除封存，非运行代码)
_archive/

# Ruff cache
.ruff_cache/

# Coverage artifacts (阶段1：报告本地生成，不提交)
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage.json

# Supply chain reports (P1-E): SBOM (sbom/backend-cyclonedx.json) 基于锁文件、
# 可复现，随仓库提交；许可证/过期报告依赖本地安装环境，仅 CI/本地审计用，不提交
sbom/licenses.json
sbom/licenses.csv
sbom/outdated.json

# Trae IDE 工作文件（计划/会话文档，勿入库）
.trae/
